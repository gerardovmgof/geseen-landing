# Copiar a .env.local (desarrollo) y cargar en Vercel (producción).
# NUNCA subir .env.local a git ni pegar estas llaves en un chat o en un prompt.

# ---- WhatsApp Cloud API (Meta) ----

# ⚠️ CRÍTICO: este token DEBE ser de un "usuario de sistema" creado en el
# Business Manager, NO el token personal del Graph API Explorer.
# El token personal vive horas, se extiende a ~60 días y luego se muere en
# silencio: el bot deja de contestar y nadie se acuerda por qué.
# Business Manager → Configuración del negocio → Usuarios → Usuarios del sistema
# → crear usuario → Generar token → sin expiración.
# Ojo: "sin expiración" no es indestructible. Se invalida si revocan permisos,
# si sacan al usuario de la cuenta, o si Meta lo revoca por su cuenta.
WHATSAPP_ACCESS_TOKEN=

# Business Manager → WhatsApp Manager → API Setup
WHATSAPP_PHONE_NUMBER_ID=

# Lo inventas tú. Es el string que Meta te va a mandar al registrar el webhook
# para comprobar que el endpoint es tuyo. Que sea largo y aleatorio.
WHATSAPP_VERIFY_TOKEN=

# Firma de los webhooks. Meta firma cada payload con el App Secret; sin esto
# cualquiera que descubra la URL puede inyectar mensajes falsos.
# developers.facebook.com → tu app → Configuración → Básica → Clave secreta
META_APP_SECRET=

# ---- Modelo ----

# platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# ---- Estado (Upstash Redis) ----

# console.upstash.com → tu base → REST API → UPSTASH_REDIS_REST_URL / _TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Operación ----

# Número de Gerardo en E.164 SIN el "+". Ej: 5214421234567
# Los mensajes que lleguen de este número entran en modo administrador.
OWNER_PHONE_NUMBER=

# Nombre de la plantilla aprobada en Meta para avisarle a Gerardo de un lead
# nuevo. Necesaria porque fuera de la ventana de 24h el texto libre no se
# entrega. Categoría UTILITY.
WHATSAPP_TEMPLATE_AVISO_LEAD=aviso_lead_nuevo

# Idioma de las plantillas registradas en Meta.
WHATSAPP_TEMPLATE_LANG=es_MX

# ---- Leads del formulario de Meta (webhook leadgen) ----

# Page Access Token con permiso `leads_retrieval`. Es el que deja leer las
# respuestas del formulario vía GET /{leadgen_id}. NO es el mismo que
# WHATSAPP_ACCESS_TOKEN: ese es de WhatsApp, este es de la Página.
META_PAGE_ACCESS_TOKEN=

# Token de verificación del webhook de leadgen. Puede ser el mismo valor que
# WHATSAPP_VERIFY_TOKEN o uno distinto, da igual mientras coincida con lo que
# se registre en el panel de Meta.
META_LEADGEN_VERIFY_TOKEN=

# Secreto del cron de leads pendientes. Vercel lo manda como Bearer al disparar
# el cron; sin él, cualquiera que descubra la URL puede dispararlo.
# Generar con: openssl rand -hex 32
CRON_SECRET=
